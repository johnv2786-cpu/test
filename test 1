                        headers: { 'Content-Type': 'application/json; charset=utf-8' },
                        body: JSON.stringify({
                            citSCORMSessionID: SCORM.sessionId || 0,
                            citSCORMAttemptID: SCORM.attemptId || 0,
                            UserID: (function (u) {
                                if (!u && u !== 0) return null;
                                if (typeof u === 'number') return Math.floor(u);
                                var n = parseInt(String(u), 10);
                                return isNaN(n) ? null : n;
                            })(SCORM.userId),
                            citSCORMPackageID: SCORM.packageId || 0,
                            CMIElement: 'cmi.core.lesson_status',
                            CMIValue: 'completed',
                            CMITimestamp: new Date().toISOString(),
                            IsCommitted: 0
                        })
                    }).catch(function () { });
                } catch (e) { }

                // ==================== KEY FIX ====================
                // Extract ACTUAL SCORE DATA (correct/total), not just percentage
                var actualScore = null;
                var maxScore = null;
                var percentage = score; // fallback percentage

                // Check if we captured correct/total counts from SCORM_SCORE_UPDATE
                if (window.__lastReportedCount && window.__lastReportedCount.correct !== undefined) {
                    actualScore = window.__lastReportedCount.correct;
                    maxScore = window.__lastReportedCount.total;
                    percentage = (actualScore / maxScore) * 100;
                }

                console.debug('Score data extracted:', {
                    actualScore: actualScore,
                    maxScore: maxScore,
                    percentage: percentage,
                    source: window.__lastReportedSource
                });

                // ===================================================
                // Now call CompleteAttempt with ACTUAL score and max score
                var payload = {
                    citSCORMAttemptID: SCORM.attemptId || 0,
                    citSCORMSessionID: SCORM.sessionId || 0,
                    RawScore: actualScore !== null ? actualScore : null, // ACTUAL POINTS (15)
                    MaxScore: maxScore !== null ? maxScore : null, // MAX POSSIBLE (100)
                    ScorePercentage: percentage !== null ? percentage : null, // PERCENTAGE (15%)
                    IsCompleted: true,
                    CompletionDate: new Date().toISOString(),
                    LessonStatus: 'completed',
                    SessionTime: null,
                    SuspendData: null
                };

                console.debug('Complete handler posting payload', payload);
                fetch(COMPLETE_ATTEMPT_URL, {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: { 'Content-Type': 'application/json; charset=utf-8' },
                    body: JSON.stringify(payload)
                })
                    .then(function (res) {
                        if (!res.ok) return res.text().then(function (t) { throw { status: res.status, body: t }; });
                        return res.text();
                    })
                    .then(function (txt) {
                        console.debug('CompleteAttempt OK', txt);
                        alert('Completed' + (payload.RawScore ? ' (score: ' + payload.RawScore + '/' + (payload.MaxScore || '?') + ')' : ''));
                    })
                    .catch(function (err) {
                        console.error('CompleteAttempt failed', err);
                        alert('CompleteAttempt failed (see console)');
                    })
                    .finally(function () {
                        btnEl.disabled = false;
                        btnEl.textContent = 'Complete';
                    });
            }
        })();

