function finalizeWithScore(score, btnEl) {
    try {
        window.__scorm_shim_lastValues = window.__scorm_shim_lastValues || {};
        window.__scorm_shim_lastValues['cmi.core.lesson_status'] = 'completed';
    } catch (e) { }

    fetch(SAVE_TRACKING_URL, {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json; charset=utf-8' },
        body: JSON.stringify({
            citSCORMSessionID: SCORM.sessionId || 0,
            citSCORMAttemptID: SCORM.attemptId || 0,
            UserID: (function (u) {
                if (!u && u !== 0) return null;
                if (typeof u === 'number') return Math.floor(u);
                var n = parseInt(String(u), 10);
                return isNaN(n) ? null : n;
            })(SCORM.userId),
            citSCORMPackageID: SCORM.packageId || 0,
            CMIElement: 'cmi.core.lesson_status',
            CMIValue: 'completed',
            CMITimestamp: new Date().toISOString(),
            IsCommitted: 0
        })
    }).catch(function () { });

    // ==================== ARTICULATE RISE FIX ====================
    var actualScore = null;
    var maxScore = null;
    var percentage = score;

    // TRY METHOD 1: Extract from SCORM API (if course sets it)
    try {
        var lv = window.__scorm_shim_lastValues || {};
        var rawScore = lv['cmi.score.raw'] || lv['cmi.core.score.raw'];
        var maxScoreVal = lv['cmi.score.max'] || lv['cmi.core.score.max'];
        
        if (rawScore !== undefined && rawScore !== null && rawScore !== '') {
            var raw = parseFloat(('' + rawScore).replace(',', '.'));
            if (!isNaN(raw) && raw >= 0) {
                actualScore = raw;
                if (maxScoreVal !== undefined && maxScoreVal !== null && maxScoreVal !== '') {
                    var max = parseFloat(('' + maxScoreVal).replace(',', '.'));
                    if (!isNaN(max) && max > 0) {
                        maxScore = max;
                        percentage = (actualScore / maxScore) * 100;
                    }
                }
                console.debug('Score from SCORM API:', { actualScore, maxScore, percentage });
            }
        }
    } catch (e) {
        console.debug('No SCORM API score available');
    }

    // TRY METHOD 2: Extract from iframe inner content (Articulate Rise results)
    if (actualScore === null) {
        try {
            var frame = document.getElementById('scormFrame');
            if (frame && frame.contentWindow) {
                var iw = frame.contentWindow;
                
                // Look for Articulate Rise quiz results in the DOM
                // Pattern 1: Look for "Correctly selected" / "Correctly unselected" counters
                try {
                    var doc = frame.contentDocument || iw.document;
                    if (doc && doc.body) {
                        var text = doc.body.innerText || '';
                        
                        // Count "Correctly selected" (correct answers)
                        var correctMatches = (text.match(/Correctly selected/gi) || []).length;
                        
                        // Try to find total questions
                        // Pattern: "Question X of Y" or similar
                        var totalMatch = text.match(/(\d+)\s+of\s+(\d+)/);
                        if (totalMatch) {
                            actualScore = parseInt(totalMatch[1], 10);
                            maxScore = parseInt(totalMatch[2], 10);
                            percentage = (actualScore / maxScore) * 100;
                            console.debug('Score from "X of Y" pattern:', { actualScore, maxScore, percentage });
                        }
                        
                        // If not found, use correctMatches count
                        if (actualScore === null && correctMatches > 0) {
                            // This is a rough estimate
                            console.log('Found correct answers count:', correctMatches);
                        }
                    }
                } catch (e) {
                    console.debug('Error examining iframe content:', e);
                }
                
                // Pattern 2: Look for Articulate Rise result text like "You scored 85%"
                try {
                    var resultText = iw.document.body.innerText || '';
                    var scoreMatch = resultText.match(/You\s+(?:scored|got)\s+(\d+(?:\.\d+)?)\s*(?:%)?/i);
                    if (scoreMatch && actualScore === null) {
                        percentage = parseFloat(scoreMatch[1]);
                        console.debug('Score from result text:', { percentage });
                    }
                } catch (e) { }
            }
        } catch (e) {
            console.debug('Error extracting from iframe:', e);
        }
    }

    console.debug('Final score data:', {
        actualScore: actualScore,
        maxScore: maxScore,
        percentage: percentage,
        source: window.__lastReportedSource
    });

    // ===================================================
    var payload = {
        citSCORMAttemptID: SCORM.attemptId || 0,
        citSCORMSessionID: SCORM.sessionId || 0,
        RawScore: actualScore !== null ? actualScore : null,
        MaxScore: maxScore !== null ? maxScore : null,
        ScorePercentage: percentage !== null ? percentage : null,
        IsCompleted: true,
        CompletionDate: new Date().toISOString(),
        LessonStatus: 'completed',
        SessionTime: null,
        SuspendData: null
    };

    console.debug('Complete handler posting payload', payload);
    fetch(COMPLETE_ATTEMPT_URL, {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json; charset=utf-8' },
        body: JSON.stringify(payload)
    })
        .then(function (res) {
            if (!res.ok) return res.text().then(function (t) { throw { status: res.status, body: t }; });
            return res.text();
        })
        .then(function (txt) {
            console.debug('CompleteAttempt OK', txt);
            var scoreText = actualScore !== null 
                ? ' (score: ' + actualScore + (maxScore ? '/' + maxScore : '') + ')' 
                : (percentage !== null ? ' (score: ' + percentage.toFixed(1) + '%)' : '');
            alert('Completed' + scoreText);
        })
        .catch(function (err) {
            console.error('CompleteAttempt failed', err);
            alert('CompleteAttempt failed (see console)');
        })
        .finally(function () {
            btnEl.disabled = false;
            btnEl.textContent = 'Complete';
        });
}



