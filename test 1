## Solution 3: Workaround - Parse Score from HTML

If the package only displays HTML like "Your Score: 13 out of 100", modify your code to extract this:

```javascript
// In your finalizeWithScore function, add this parsing:
if (actualScore === null) {
    try {
        var frame = document.getElementById('scormFrame');
        if (frame && frame.contentDocument) {
            var text = frame.contentDocument.body.innerText;
            
            // Pattern 1: "13 out of 100"
            var m1 = text.match(/(\d+)\s+out\s+of\s+(\d+)/i);
            if (m1) {
                actualScore = parseInt(m1[1], 10);
                maxScore = parseInt(m1[2], 10);
                percentage = (actualScore / maxScore) * 100;
                console.log('Extracted from "X out of Y" format:', { actualScore, maxScore, percentage });
            }
            
            // Pattern 2: "Score: 13/100"
            if (actualScore === null) {
                var m2 = text.match(/Score:\s*(\d+)\s*\/\s*(\d+)/i);
                if (m2) {
                    actualScore = parseInt(m2[1], 10);
                    maxScore = parseInt(m2[2], 10);
                    percentage = (actualScore / maxScore) * 100;
                    console.log('Extracted from "X/Y" format:', { actualScore, maxScore, percentage });
                }
            }
        }
    } catch (e) {
        console.log('Error parsing HTML for score:', e);
    }
}
```

